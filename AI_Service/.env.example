# AI_Service 运行配置（复制为 .env 后填写）
AI_INTERNAL_TOKEN=dev-internal-token
AI_HOST=0.0.0.0
AI_PORT=8000

# OpenAI 兼容模型；三项都填写才会启用真实生成
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FIRST_TOKEN_TIMEOUT=20
LLM_TOTAL_TIMEOUT=110

# 风格档案路径；留空使用项目根目录的 鲁迅散文风格配置.json
LUXUN_STYLE_CONFIG=

# 仅测试/演示使用；生产不得开启
AI_MOCK_MODE=false
LOG_LEVEL=INFO

# 本地 Embedding + Chroma；关闭时检索返回空、向量同步直接成功
RAG_ENABLED=false
# 留空分别使用 AI_Service/data/chroma 与 AI_Service/data/models
CHROMA_DIR=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=
# 首次下载模型可走镜像（可选）
# HF_ENDPOINT=https://hf-mirror.com

# 关怀检测的模型复核：默认关闭；开启后 3 秒超时，失败回退规则
CARE_LLM_ENABLED=false
